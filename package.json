{
  "name": "zing-calendar",
  "private": true,
  "version": "2.15.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run version:check && tsc -b && vite build && node scripts/service-worker.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "version:check": "node scripts/version.mjs --check",
    "release:version": "node scripts/version.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@uiw/react-md-editor": "^4.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "@playwright/test": "^1.55.0"
  }
}
